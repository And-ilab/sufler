# Development-only fallback when Django auth API is not running.
# Leave empty in integrated and production environments.
VITE_DEV_RBAC_ROLES=
# Proxy target must match infra BACKEND_PORT_HOST (compose default 8001).
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Optional mock_ldap login for local admin APIs (defaults: software admin).
# Password must match AUTH_MOCK_LDAP_DEFAULT_PASSWORD from infra/.env
# VITE_DEV_AUTH_USER=dev-role-01
# VITE_DEV_AUTH_PASSWORD=dev-only-password
