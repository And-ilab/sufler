DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Browser Origin for Vite SPA → Django CSRF (comma-separated).
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8001,http://localhost:8001

# Development: AUTH_BACKEND=mock_ldap (P2-01). Prod I.10: AUTH_BACKEND=ldaps.
# AUTH_MODE is an alias kept for backward compatibility.
AUTH_BACKEND=mock_ldap
AUTH_MODE=mock_ldap
AUTH_MOCK_LDAP_DEFAULT_PASSWORD=replace-with-dev-only-password

# --- SUZ Model B ingest (Bitrix → /api/v1/knowledge/events) ---
# mock: empty HMAC allowed for local INT-T. prod: HMAC required (see infra/test/.env.example).
SUZ_INGEST_MODE=mock
SUZ_WEBHOOK_PATH=/api/v1/knowledge/events
# SUZ Model B webhook HMAC. Empty is allowed only for local mock development.
SUZ_WEBHOOK_HMAC_SECRET=replace-with-a-shared-suz-webhook-secret
SUZ_ALLOWED_IBLOCK_IDS=

# INT-09 polling fallback (optional in mock; required for prod cutover).
BITRIX_REST_BASE_URL=
BITRIX_SERVICE_TOKEN=
BITRIX_CHANGES_PATH=/local/api/sufler/v1/changes
BITRIX_HTTP_TIMEOUT_SECONDS=15
SUZ_RECONCILE_ENABLED=false
SUZ_RECONCILE_LIMIT=100
SUZ_RECONCILE_INTERVAL_SECONDS=300

# VI.2 Oktell telephony. Default points at local oktell_mock (P1-14 / P4-02).
# OKTELL_MODE=mock|prod — prod uses TEST line T+45 profile (see infra/test/.env.example).
OKTELL_MODE=mock
OKTELL_ENABLED=false
OKTELL_WS_URL=ws://127.0.0.1:8766
OKTELL_MOCK_WS_URL=ws://127.0.0.1:8766
OKTELL_PROD_WS_URL=
OKTELL_SUBSCRIBE_EVENT=phoneevent
OKTELL_OPEN_TIMEOUT_SECONDS=5
OKTELL_PROFILE_ID=test_line_t45
OKTELL_TEST_LINE_LABEL=T+45 test line
OKTELL_TEST_QUEUE=
OKTELL_TEST_MARKING=TEST_OKTELL_T45

# VI.3 structured audit → KUMA (P2-05 schema_version=1.0 unchanged).
# Local: file only. Prod: file,kuma + AUDIT_KUMA_COLLECTOR_URL (see infra/test/.env.example).
AUDIT_ENABLED=true
AUDIT_SINKS=file
AUDIT_KUMA_COLLECTOR_URL=
AUDIT_HTTP_COLLECTOR_URL=
AUDIT_HTTP_TIMEOUT_SECONDS=5
AUDIT_DEVICE_VENDOR=Belarusbank
AUDIT_DEVICE_PRODUCT=AI_Hub

POSTGRES_DB=sufler
POSTGRES_USER=sufler
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_PORT_HOST=5432

REDIS_PORT_HOST=6379

MINIO_ROOT_USER=sufler
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
MINIO_API_PORT_HOST=9000
MINIO_CONSOLE_PORT_HOST=9001

BACKEND_PORT_HOST=8001
FRONTEND_PORT_HOST=5173

# Dev-only: portal launcher roles when session is anonymous.
# Comma-separated I.4 role codes. Leave empty to hide launcher until login.
VITE_DEV_RBAC_ROLES=contact_center_telephony_operator,ai_hub_admin
